{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm test && npm run build:demo",
  "outputDirectory": "dist",
  "installCommand": "npm ci && npm ci --prefix apps/mobile",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{data/map-layers/*.json,data/map-layers/*.geojson,src/glendale-permits.json,VERSION}",
      "maxDuration": 60
    },
    "api/gis.py": {
      "maxDuration": 60,
      "memory": 2048
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/app/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/classic",
      "destination": "/index.html"
    },
    {
      "source": "/api/gis",
      "destination": "/api/gis"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/app/(.*)",
      "destination": "/app/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "x-content-type-options",
          "value": "nosniff"
        },
        {
          "key": "referrer-policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "x-frame-options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "permissions-policy",
          "value": "camera=(), microphone=(), payment=(), usb=()"
        },
        {
          "key": "content-security-policy-report-only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://fonts.googleapis.com; img-src 'self' data: blob: https://*.tile.openstreetmap.org https://tiles.openfreemap.org https://s3.amazonaws.com; font-src 'self' data: https://tiles.openfreemap.org https://fonts.gstatic.com; connect-src 'self' https://tiles.openfreemap.org https://s3.amazonaws.com; worker-src 'self' blob:; child-src 'self' blob:; frame-src 'self' https://www.openstreetmap.org; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/app/_expo/static/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/map-layers/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/gis",
      "schedule": "*/5 * * * *"
    }
  ]
}
